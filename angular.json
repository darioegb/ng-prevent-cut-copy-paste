{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ng-prevent-cut-copy-paste": {
      "projectType": "library",
      "root": "projects/ng-prevent-cut-copy-paste",
      "sourceRoot": "projects/ng-prevent-cut-copy-paste/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "projects/ng-prevent-cut-copy-paste/tsconfig.lib.json",
            "project": "projects/ng-prevent-cut-copy-paste/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ng-prevent-cut-copy-paste/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ng-prevent-cut-copy-paste/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "build-for-test": {
          "builder": "@angular/build:application",
          "options": {
            "tsConfig": "projects/ng-prevent-cut-copy-paste/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ng-prevent-cut-copy-paste/tsconfig.spec.json",
            "buildTarget": "ng-prevent-cut-copy-paste:build-for-test",
            "setupFiles": [
              "projects/ng-prevent-cut-copy-paste/src/test-setup.ts"
            ],
            "include": ["**/*.spec.ts"],
            "runner": "vitest"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ng-prevent-cut-copy-paste/**/*.ts",
              "projects/ng-prevent-cut-copy-paste/**/*.html"
            ]
          }
        }
      }
    },
    "ng-prevent-cut-copy-paste-showcase": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/ng-prevent-cut-copy-paste-showcase",
      "sourceRoot": "projects/ng-prevent-cut-copy-paste-showcase/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/ng-prevent-cut-copy-paste-showcase"
            },
            "index": "projects/ng-prevent-cut-copy-paste-showcase/src/index.html",
            "polyfills": [
              "projects/ng-prevent-cut-copy-paste-showcase/src/polyfills.ts"
            ],
            "tsConfig": "projects/ng-prevent-cut-copy-paste-showcase/tsconfig.app.json",
            "assets": [
              "projects/ng-prevent-cut-copy-paste-showcase/src/favicon.ico",
              "projects/ng-prevent-cut-copy-paste-showcase/src/assets"
            ],
            "styles": [
              "projects/ng-prevent-cut-copy-paste-showcase/src/styles.scss"
            ],
            "scripts": [],
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "browser": "projects/ng-prevent-cut-copy-paste-showcase/src/main.ts"
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "projects/ng-prevent-cut-copy-paste-showcase/src/environments/environment.ts",
                  "with": "projects/ng-prevent-cut-copy-paste-showcase/src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "ng-prevent-cut-copy-paste-showcase:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "ng-prevent-cut-copy-paste-showcase:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "ng-prevent-cut-copy-paste-showcase:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ng-prevent-cut-copy-paste-showcase/tsconfig.spec.json",
            "polyfills": [
              "projects/ng-prevent-cut-copy-paste-showcase/src/polyfills.ts"
            ],
            "buildTarget": "ng-prevent-cut-copy-paste-showcase:build",
            "runner": "vitest"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ng-prevent-cut-copy-paste-showcase/**/*.ts",
              "projects/ng-prevent-cut-copy-paste-showcase/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "76bc2ef6-ca02-47cf-8b2b-ee2cff48713c"
  }
}

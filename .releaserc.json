{
  "branches": ["main"],
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    [
      "@semantic-release/release-notes-generator",
      { "preset": "conventionalcommits" }
    ],
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node scripts/set-lib-version.mjs ${nextRelease.version} && node scripts/update-readme.mjs && pnpm ng build ng-prevent-cut-copy-paste"
      }
    ],
    ["@semantic-release/npm", { "pkgRoot": "dist/ng-prevent-cut-copy-paste" }],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "README.md",
          "projects/ng-prevent-cut-copy-paste/package.json"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
